# Modelo de configuração do Açaí Carioca Studio.
# Copie este arquivo para ".env.local" e preencha com os valores do seu projeto
# (Supabase → Project Settings → API). O ".env.local" NÃO vai para o GitHub.
#
# No Vercel, cadastre estas mesmas variáveis em Project Settings → Environment Variables.
#
# ATENÇÃO: use somente a chave "anon / public". NUNCA coloque aqui a chave
# "service_role" — ela dá acesso total ao banco e não pode ficar no navegador.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
